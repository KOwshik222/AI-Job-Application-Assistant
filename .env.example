# =================================================================
# AI Job Application Assistant Configuration
# =================================================================

# --- LLM Provider Selection ---
# Supported providers: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# --- Job Search Provider ---
# Tavily API Key for real-time live job discovery across ATS & portals
TAVILY_API_KEY=your_tavily_api_key_here

# --- LangSmith Observability & Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-job-application-assistant
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Database & Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/job_assistant.db
RESUME_STORAGE_PATH=./storage/resumes
CHROMA_PERSIST_DIR=./data/chroma

# --- Guardrails & Application Limits ---
MAX_APPLICATIONS_PER_DAY=20
MATCH_THRESHOLD=75
SAME_COMPANY_COOLDOWN_DAYS=30

# --- Email Summary Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# --- MCP Tool Configuration ---
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,mcp_server.server

# --- Model Selection ---
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
