# OpenAI
OPENAI_API_KEY=sk-your-key

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-job-application-assistant
LANGCHAIN_API_KEY=ls-your-key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application
DATABASE_URL=sqlite+aiosqlite:///./data/job_assistant.db
RESUME_STORAGE_PATH=./storage/resumes
CHROMA_PERSIST_DIR=./data/chroma

# Guardrails
MAX_APPLICATIONS_PER_DAY=20
MATCH_THRESHOLD=75
SAME_COMPANY_COOLDOWN_DAYS=30

# Job search (optional - falls back to mock if unset)
TAVILY_API_KEY=

# Email (SMTP — required for real email delivery)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# MCP
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,mcp_server.server
