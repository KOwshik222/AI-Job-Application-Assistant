# LLM Provider ("gemini" or "openai") — STRICT: never falls back cross-provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=

# OpenAI (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key

# Explicit demo mode — set true ONLY for demo/testing without real LLM
# NEVER auto-activated from missing API keys in production
DEMO_MODE=false

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-job-application-assistant
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/job_assistant.db
RESUME_STORAGE_PATH=./storage/resumes
CHROMA_PERSIST_DIR=./data/chroma

# Guardrails
MAX_APPLICATIONS_PER_DAY=20
MATCH_THRESHOLD=75
SAME_COMPANY_COOLDOWN_DAYS=30

# Job search — required for live search
TAVILY_API_KEY=your-tavily-api-key

# Email (SMTP — required for real email delivery)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# MCP Server process
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,mcp_server.server
MCP_CONNECTION_TIMEOUT=30
MCP_TOOL_TIMEOUT=60

# Browser — set BROWSER_HEADLESS=false for human-in-the-loop testing
BROWSER_HEADLESS=true
BROWSER_SESSION_TIMEOUT=600
